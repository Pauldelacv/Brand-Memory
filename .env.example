# Supabase — project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# AI providers. The app is provider-agnostic (see src/lib/ai/providers).
# AI_TEXT_PROVIDER:      anthropic | openai
# AI_EMBEDDING_PROVIDER: openai | local
AI_TEXT_PROVIDER=anthropic
AI_EMBEDDING_PROVIDER=openai

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model overrides
# AI_TEXT_MODEL=claude-sonnet-5
# AI_EMBEDDING_MODEL=text-embedding-3-small
